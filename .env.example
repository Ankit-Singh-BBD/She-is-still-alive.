# MADHURITA ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# Never commit .env files to version control.

# =============================================================================
# LLM PROVIDER (Required for cognitive stages)
# =============================================================================
# Primary LLM provider: "google" | "anthropic" | "openai"
LLM_PROVIDER=google

# Google (Gemini) - Used by default
GOOGLE_API_KEY=

# Anthropic (Claude) - Alternative
ANTHROPIC_API_KEY=

# OpenAI - Alternative
OPENAI_API_KEY=

# Model names (override defaults if needed)
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=3000
NODE_ENV=development

# =============================================================================
# DATABASE
# =============================================================================
# SQLite database file path (relative to project root)
DATABASE_PATH=./data/madhurita.db

# =============================================================================
# SESSION & AUTHENTICATION
# =============================================================================
# Secret for session token signing (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Session cookie settings
SESSION_COOKIE_NAME=madhurita_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_MS=2592000000  # 30 days

# =============================================================================
# TTS (Text-to-Speech) - Optional
# =============================================================================
# Google Cloud TTS
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=en-US-Neural2-F
GOOGLE_TTS_LANGUAGE=en-US

# =============================================================================
# VOICE / LIVE SESSION
# =============================================================================
# Gemini Live API (for voice streaming)
GEMINI_LIVE_API_KEY=

# =============================================================================
# PROACTIVITY / SCHEDULING
# =============================================================================
# Quiet hours (24-hour format, local timezone)
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# Proactivity feature flags (true/false)
PROACTIVITY_ENABLED=true
PROACTIVITY_NOTIFICATIONS_ENABLED=true

# =============================================================================
# BACKUP (Optional)
# =============================================================================
BACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM (cron)
BACKUP_DESTINATION=./backups

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable major subsystems (for phased rollout)
FLAG_COGNITION=true
FLAG_ACTIONS=true
FLAG_TASKS=true
FLAG_LEARNING=true
FLAG_PROACTIVITY=true
FLAG_VOICE=true
FLAG_REALTIME=true
FLAG_ADVANCED_MODULES=false

# =============================================================================
# LOGGING & DEBUGGING
# =============================================================================
LOG_LEVEL=info  # debug | info | warn | error
LOG_PRETTY=true