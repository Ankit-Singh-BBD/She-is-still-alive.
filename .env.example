# MADHURITA — ENVIRONMENT
#
# Copy to `.env` and fill in what you want to change. Every variable here has a
# working default, so an empty `.env` is a valid `.env`: she boots, thinks, and
# remembers without any of it set.
#
# Every variable in this file is one that `server/config/env.ts` actually reads.
# If it is not listed here, nothing reads it. Values are validated at boot and a
# bad one is reported by name before any subsystem starts.
#
# Never commit `.env`. It is already in `.gitignore`.

# =============================================================================
# LANGUAGE FACULTY
# =============================================================================
# Optional. Without a key she still runs: stages 4-6 (UNDERSTAND, REASON,
# DECIDE), 9 (RESPOND) and 10 (LEARN) fall back to the deterministic heuristics
# they already carry. She is more literal and less fluent, and entirely alive.
#
# The boot banner says which mode you are in. Leaving this blank is a supported
# choice, not a broken configuration.
GOOGLE_API_KEY=

# Only "google" is implemented — @google/genai is the sole LLM client in
# package.json. Setting anything else is rejected at boot rather than failing on
# the first request.
LLM_PROVIDER=google

# Reasoning faculty: small, fast, called several times per cognitive cycle.
#
# `gemini-2.5-flash-lite` is what the Build Book names and what this shipped
# with. It is still in `models.list` and `generateContent` now answers 404 on it
# — "no longer available to new users" — so every thinking stage threw and she
# answered nothing. This is the successor Google's own error message points at.
LLM_REASONING_MODEL=gemini-3.5-flash-lite

# Live voice faculty: bidirectional audio.
LLM_LIVE_MODEL=gemini-3.1-flash-live-preview

# Which prebuilt Gemini voice speaks her lines, and in what language. Both blank
# by default, and blank is a real answer: the provider's own default voice is
# fine, and a hard language tag is actively wrong for Hinglish — `en-IN` would
# have it spell Roman-script Hindi out as English words. Leave both empty unless
# you have listened to the alternatives.
LLM_VOICE_NAME=
LLM_VOICE_LANGUAGE=

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
# Per-request deadline. A faculty that has not answered by now is treated as
# absent and the stage uses its fallback, so a slow network degrades her rather
# than hanging her.
LLM_TIMEOUT_MS=20000

# =============================================================================
# SERVER
# =============================================================================
PORT=3000
# Loopback by default. She holds one person's memory; binding 0.0.0.0 publishes
# that surface to every device on the current network, so opening up is a
# deliberate act.
HOST=127.0.0.1
NODE_ENV=development

# =============================================================================
# DATABASE
# =============================================================================
# SQLite file, relative to the project root. Its directory is created if needed.
# WAL, foreign keys and a 5s busy timeout are set unconditionally in code.
DATABASE_PATH=./data/madhurita.db

# =============================================================================
# SESSION
# =============================================================================
# There is no signing secret to configure. A session token is 256 bits of
# `randomBytes` issued once and stored only as its SHA-256 hash, so there is
# nothing for a secret to protect and nothing to rotate.
SESSION_COOKIE_NAME=madhurita_session
# Set to true behind HTTPS.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
# 30 days.
SESSION_MAX_AGE_MS=2592000000

# =============================================================================
# WHERE SHE IS
# =============================================================================
# Optional, and absent by default on purpose: rather than guess a location and
# then narrate the weather somewhere she is not, she says she does not know.
# Both coordinates are required together — half a coordinate is not a place.
#
# Decimal degrees or the degrees-minutes-seconds that Google Maps' "copy
# coordinates" actually hands you — `25°58'31.7"N`, `-79.4489`, `25 58 31.7 N`
# and `25:58:31.7N` are all read. A hemisphere letter or a minus sign, not both.
#
# This file is committed. Real coordinates belong in `.env`, which is not.
LOCATION_LATITUDE=
LOCATION_LONGITUDE=
LOCATION_LABEL=

# =============================================================================
# PROACTIVITY
# =============================================================================
PROACTIVITY_ENABLED=true
# Quiet hours, local time, 24-hour. A candidate held back for quiet hours is
# deferred to the end of the window and re-evaluated then — not dropped.
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# =============================================================================
# BACKGROUND SWEEPS
# =============================================================================
# Each sweep wakes, asks the database one bounded question, and sleeps again.
# These are latency floors, not throughput knobs.
PROACTIVE_SWEEP_INTERVAL_MS=60000
TASK_SWEEP_INTERVAL_MS=15000
LOOP_SWEEP_INTERVAL_MS=60000
# How often she goes back over cycles the in-cycle learn stage kept nothing from
# — a degraded cycle whose learn stage threw, or one that predates a rule. Five
# minutes because nobody is waiting on it; with a key each cycle it picks up is a
# model call, so this is deliberately the slowest sweep of the four. Off entirely
# when FLAG_LEARNING=false.
LEARNING_SWEEP_INTERVAL_MS=300000

# =============================================================================
# BACKUP
# =============================================================================
BACKUP_ENABLED=false
BACKUP_DESTINATION=./backups
# An interval, not a cron expression: parsing cron correctly would mean taking a
# dependency for a single scheduled job.
BACKUP_INTERVAL_HOURS=24

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Every one of these is read by `server/app.ts` at boot and named in the banner,
# and turning one off removes a capability rather than hiding a button.
FLAG_COGNITION=true
FLAG_ACTIONS=true
FLAG_TASKS=true
# Both halves of learning. Off, stages 10 and 11 still run inside each cycle but
# a cycle they kept nothing from is never revisited — see the sweep above.
FLAG_LEARNING=true
FLAG_PROACTIVITY=true
FLAG_VOICE=true
FLAG_REALTIME=true

# Personality modulation. On, because its "off" state is one fixed neutral
# register for every person at every hour, which is the flat robotic voice this
# application exists not to have. It has no credential and no network call, and
# writes nothing durable — three in-memory overrides that expire on their own.
FLAG_PERSONALITY=true

# The four advanced faculties, and the master switch over all four. On by
# default: they are implemented, they run inside the cycle, and an owner who has
# to discover four more variables before she reads an emotional signal is an
# owner running the flat version of her without knowing it.
#
# Coarse and fine on purpose. This one turns the whole subsystem off:
FLAG_ADVANCED_MODULES=true
# and these turn off one capability each, because their consequences differ.
# Emotion reading and relationship context write only expiring in-memory tone.
# Long-horizon reflection writes durable semantic_memory rows. Dream
# consolidation retires existing recollections from retrieval. Wanting the first
# two and not the last is reasonable, and no single flag can say it.
FLAG_EMOTION_READING=true
FLAG_RELATIONSHIP_CONTEXT=true
FLAG_LONG_HORIZON_REFLECTION=true
FLAG_DREAM_CONSOLIDATION=true

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_PRETTY=true
